IMAGE       = "generic/ubuntu2204"   # or "generic/rhel9"
BOX_VERSION = "4.3.12"
NAME        = "master"
CPU         = 4
MEMORY      = 8192
HDD         = "40GB"
IP_MASTER   = "192.168.100.10"

Vagrant.configure("2") do |config|
  config.vm.hostname = NAME
  config.vm.box = IMAGE
  config.vm.box_version = BOX_VERSION
  config.vm.box_check_update = false

  config.vm.provider :libvirt do |libvirt|
    libvirt.driver = "kvm"
    libvirt.memory = MEMORY
    libvirt.cpus   = CPU
    libvirt.mgmt_attach = false   # disable automatic NIC creation
  end

  # NAT network for internet access
  config.vm.network "private_network",
    type: "dhcp",
    libvirt__network_name: "vm-nat",
    libvirt__persistent: true,
    libvirt__always_destroy: false

  # Static IP for host ↔ guest communication
  config.vm.network "private_network",
    ip: IP_MASTER,
    libvirt__network_name: "vm-local",
    libvirt__persistent: true,
    libvirt__always_destroy: false

  config.vm.provision "shell", inline: <<-SHELL
    # Update and upgrade
    sudo apt-get update -y
    sudo apt-get upgrade -y

    # Install required packages
    sudo apt-get install -y net-tools netplan.io

    # Enable IP forwarding
    sudo tee /etc/sysctl.d/99-vm-routing.conf > /dev/null <<EOF
net.ipv4.ip_forward = 1
EOF
    sudo sysctl --system
    # Write netplan configuration
    sudo tee /etc/netplan/99-vm-routing.yaml > /dev/null <<EOF
network:
  version: 2
  ethernets:
    eth1:
      routes:
        - to: 192.168.10.0/24
          via: 192.168.100.1
EOF

    # Apply netplan
    sudo netplan apply
  SHELL
end
